# Copie para backend/.env (o .env NÃO é versionado).
PORT=3333

# Chave da Anthropic. Sem ela, o assistente roda em MODO DEMONSTRATIVO (respostas locais).
# A chave fica SOMENTE no back-end — nunca use variáveis VITE_* para segredos.
ANTHROPIC_API_KEY=

# Opcional: modelo e timeout da chamada ao LLM.
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTENTE_TIMEOUT_MS=30000

# Opcional: force o modo local mesmo com chave configurada.
# ASSISTENTE_MODO=demonstrativo

# Fuso usado para definir "hoje" na regra de vencimento.
TZ_NEGOCIO=America/Sao_Paulo
